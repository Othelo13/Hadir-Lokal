# Contoh konfigurasi server produksi (isi melalui environment variables/secret manager hosting)
# Jangan menyimpan nilai asli token atau file .env di GitHub.
NODE_ENV=production
HOST=0.0.0.0
PORT=5197
HADIR_PUBLIC_ORIGIN=https://hadir.example.org
# Folder absolut pada volume persisten, berisi hadir.sqlite dan selfies/
HADIR_DATA_DIR=/var/lib/hadir
# Wajib untuk URL publik: buat token acak panjang, minimal 32 karakter.
# Contoh generator: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
HADIR_SETUP_TOKEN=GANTI_DENGAN_HASIL_GENERATOR_TOKEN_64_KARAKTER_HEKSADESIMAL
